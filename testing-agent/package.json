{
  "name": "testing-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=sentinelqa-web",
    "build": "npm run build --workspace=sentinelqa-web",
    "start": "npm run start --workspace=sentinelqa-web",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js --env production",
    "pm2:logs": "pm2 logs testing-agent",
    "pm2:status": "pm2 status"
  }
}

